---
import { business, services, nav } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;

const year = new Date().getFullYear();
const company = nav.filter((n) => ['About Us', 'Our Work', 'Gallery', 'Blog', 'Contact'].includes(n.label));
---

<footer class="bg-forest-950 text-forest-100">
  {
    showCta && (
      <!-- CTA band -->
      <div class="container-px">
        <div class="relative -mb-px translate-y-[-2rem] overflow-hidden rounded-[2rem] bg-gradient-to-br from-forest-600 to-forest-800 px-8 py-12 shadow-premium md:translate-y-[-3rem] md:px-14 md:py-16">
          <div class="absolute -right-10 -top-10 h-48 w-48 rounded-full bg-forest-400/20 blur-3xl" />
          <div class="relative flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
            <div class="max-w-xl">
              <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">
                Ready for the best lawn on your street?
              </h2>
              <p class="mt-3 text-forest-100/90">
                Get a free, no-obligation quote today. Most estimates returned within 24 hours.
              </p>
            </div>
            <div class="flex flex-shrink-0 flex-col gap-3 sm:flex-row">
              <a href="/contact" class="btn-primary !bg-white !text-forest-800 hover:!bg-bone-100">
                Get a Free Quote
              </a>
              <a href={business.phoneHref} class="btn-secondary">
                <Icon name="phone" class="h-4 w-4" />
                {business.phone}
              </a>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <!-- Main footer -->
  <div class="container-px pb-10 pt-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest-800 text-forest-400">
            <Icon name="leaf" class="h-6 w-6" />
          </span>
          <span class="flex flex-col leading-none text-white">
            <span class="font-display text-xl font-extrabold tracking-tight">OBSCURA</span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.35em] text-forest-400"
              >Lawn Care</span
            >
          </span>
        </a>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-forest-100/70">
          Premium lawn maintenance and landscaping that keeps your property healthy, vibrant, and
          beautiful all year long. Locally owned and proudly serving the Triangle since {business.founded}.
        </p>
        <div class="mt-6 flex gap-3">
          {
            Object.entries(business.social).map(([key, href]) => (
              <a
                href={href}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-forest-800/60 text-forest-200 transition-colors hover:bg-forest-600 hover:text-white"
                aria-label={key}
              >
                <span class="text-xs font-bold uppercase">{key[0]}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Services</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={`/services/${s.slug}`} class="text-forest-100/70 transition-colors hover:text-forest-400">
                  {s.title}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/services" class="font-semibold text-forest-400 transition-colors hover:text-forest-300"
              >All Services →</a
            >
          </li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Company</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {
            company.map((c) => (
              <li>
                <a href={c.href} class="text-forest-100/70 transition-colors hover:text-forest-400">
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-white">Get in touch</h3>
        <ul class="mt-5 space-y-4 text-sm">
          <li class="flex gap-3">
            <Icon name="map-pin" class="h-5 w-5 flex-shrink-0 text-forest-400" />
            <span class="text-forest-100/70">
              {business.address.street}<br />
              {business.address.city}, {business.address.region} {business.address.postalCode}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="phone" class="h-5 w-5 flex-shrink-0 text-forest-400" />
            <a href={business.phoneHref} class="text-forest-100/70 transition-colors hover:text-forest-400"
              >{business.phone}</a
            >
          </li>
          <li class="flex gap-3">
            <Icon name="mail" class="h-5 w-5 flex-shrink-0 text-forest-400" />
            <a href={business.emailHref} class="text-forest-100/70 transition-colors hover:text-forest-400"
              >{business.email}</a
            >
          </li>
          <li class="flex gap-3">
            <Icon name="clock" class="h-5 w-5 flex-shrink-0 text-forest-400" />
            <span class="text-forest-100/70">
              {business.hours[0].day}<br />
              {business.hours[0].time}
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-forest-800/60 pt-8 text-xs text-forest-100/60 sm:flex-row"
    >
      <p>© {year} {business.legalName}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="transition-colors hover:text-forest-400">Privacy Policy</a>
        <a href="/terms" class="transition-colors hover:text-forest-400">Terms of Service</a>
        <span>Licensed &amp; Insured</span>
      </div>
    </div>
  </div>
</footer>
