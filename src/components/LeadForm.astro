---
import { services } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<form
  class:list={['space-y-4', !compact && 'rounded-3xl bg-white p-6 shadow-premium sm:p-8']}
  x-data="{ sent: false }"
  @submit.prevent="sent = true"
>
  {!compact && <h3 class="font-display text-2xl font-bold text-forest-900">Request your free quote</h3>}

  <div x-show="!sent" x-transition class="space-y-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="lf-name" class="mb-1.5 block text-sm font-semibold text-forest-900">Full name</label>
        <input
          id="lf-name"
          name="name"
          type="text"
          required
          placeholder="Jane Doe"
          class="w-full rounded-xl border border-bone-200 bg-bone-50 px-4 py-3 text-sm text-forest-900 outline-none transition focus:border-forest-500 focus:bg-white focus:ring-2 focus:ring-forest-400/30"
        />
      </div>
      <div>
        <label for="lf-phone" class="mb-1.5 block text-sm font-semibold text-forest-900">Phone</label>
        <input
          id="lf-phone"
          name="phone"
          type="tel"
          required
          placeholder="(555) 123-4567"
          class="w-full rounded-xl border border-bone-200 bg-bone-50 px-4 py-3 text-sm text-forest-900 outline-none transition focus:border-forest-500 focus:bg-white focus:ring-2 focus:ring-forest-400/30"
        />
      </div>
    </div>
    <div>
      <label for="lf-email" class="mb-1.5 block text-sm font-semibold text-forest-900">Email</label>
      <input
        id="lf-email"
        name="email"
        type="email"
        required
        placeholder="jane@email.com"
        class="w-full rounded-xl border border-bone-200 bg-bone-50 px-4 py-3 text-sm text-forest-900 outline-none transition focus:border-forest-500 focus:bg-white focus:ring-2 focus:ring-forest-400/30"
      />
    </div>
    <div>
      <label for="lf-service" class="mb-1.5 block text-sm font-semibold text-forest-900">Service needed</label>
      <select
        id="lf-service"
        name="service"
        class="w-full rounded-xl border border-bone-200 bg-bone-50 px-4 py-3 text-sm text-forest-900 outline-none transition focus:border-forest-500 focus:bg-white focus:ring-2 focus:ring-forest-400/30"
      >
        {services.map((s) => <option value={s.slug}>{s.title}</option>)}
        <option value="other">Something else</option>
      </select>
    </div>
    <button type="submit" class="btn-primary w-full">
      Get My Free Quote
      <Icon name="arrow" class="h-4 w-4" />
    </button>
    <p class="text-center text-xs text-forest-900/50">
      No spam, ever. Most estimates returned within 24 hours.
    </p>
  </div>

  <!-- Success state -->
  <div x-show="sent" x-cloak x-transition class="py-8 text-center">
    <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-forest-100 text-forest-600">
      <Icon name="check" class="h-8 w-8" />
    </span>
    <h3 class="mt-5 font-display text-2xl font-bold text-forest-900">Request received!</h3>
    <p class="mt-2 text-forest-900/65">
      Thanks for reaching out. A member of our team will be in touch within one business day.
    </p>
  </div>
</form>
