---
import { testimonials } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="reviews" class="section-py bg-forest-950 text-white">
  <div class="container-px">
    <SectionHeading
      eyebrow="Client Reviews"
      title="Loved by homeowners <br class='hidden sm:block'/> across the Triangle"
      subtitle="Real words from real clients. Our 4.9-star average is built one beautiful lawn at a time."
      light
    />

    <div
      class="reveal relative mt-14"
      x-data={`{
        active: 0,
        total: ${testimonials.length},
        timer: null,
        start() { this.timer = setInterval(() => this.next(), 6000) },
        stop() { clearInterval(this.timer) },
        next() { this.active = (this.active + 1) % this.total },
        prev() { this.active = (this.active - 1 + this.total) % this.total },
        go(i) { this.active = i }
      }`}
      x-init="start()"
      @mouseenter="stop()"
      @mouseleave="start()"
    >
      <div class="relative mx-auto max-w-4xl">
        {
          testimonials.map((t, i) => (
            <div
              x-show={`active === ${i}`}
              x-transition:enter="transition ease-out duration-500"
              x-transition:enter-start="opacity-0 translate-y-4"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-cloak={i !== 0 ? true : undefined}
              class="rounded-[2rem] border border-forest-800/60 bg-forest-900/60 p-8 text-center backdrop-blur md:p-14"
            >
              <Icon name="quote" class="mx-auto h-10 w-10 text-forest-500/60" />
              <div class="mt-6 flex justify-center gap-1">
                {Array.from({ length: t.rating }).map(() => (
                  <Icon name="star" class="h-5 w-5 fill-forest-400 text-forest-400" />
                ))}
              </div>
              <blockquote class="mt-6 font-display text-2xl font-semibold leading-snug text-white md:text-3xl">
                “{t.quote}”
              </blockquote>
              <div class="mt-8">
                <p class="font-bold text-forest-400">{t.name}</p>
                <p class="text-sm text-forest-100/60">{t.role}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Controls -->
      <div class="mt-10 flex items-center justify-center gap-6">
        <button
          @click="prev()"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-forest-700 text-forest-200 transition-colors hover:bg-forest-800"
          aria-label="Previous review"
        >
          <Icon name="arrow" class="h-5 w-5 rotate-180" />
        </button>
        <div class="flex gap-2">
          {
            testimonials.map((_, i) => (
              <button
                @click={`go(${i})`}
                :class={`active === ${i} ? 'w-8 bg-forest-400' : 'w-2.5 bg-forest-700'`}
                class="h-2.5 rounded-full transition-all duration-300"
                aria-label={`Go to review ${i + 1}`}
              />
            ))
          }
        </div>
        <button
          @click="next()"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-forest-700 text-forest-200 transition-colors hover:bg-forest-800"
          aria-label="Next review"
        >
          <Icon name="arrow" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </div>
</section>
