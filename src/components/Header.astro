---
import { nav, business } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.startsWith('/#')) return false; // same-page anchor, never "active"
  if (href === '/') return path === '/';
  const base = href.split('#')[0];
  return path === base || path.startsWith(base + '/');
};
---

<header
  x-data="{ scrolled: false }"
  x-init="scrolled = window.scrollY > 20; window.addEventListener('scroll', () => scrolled = window.scrollY > 20)"
  :class="scrolled ? 'bg-white/95 shadow-card backdrop-blur-md' : 'bg-transparent'"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  data-header
>
  <nav
    class="container-px flex h-20 items-center justify-between transition-colors duration-300"
    :class="scrolled ? 'text-forest-900' : 'text-white'"
    aria-label="Primary"
  >
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${business.name} — home`}>
      <span
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest-800 text-forest-400 transition-colors group-hover:bg-forest-600"
      >
        <Icon name="leaf" class="h-6 w-6" />
      </span>
      <span class="flex flex-col leading-none" data-logo-text>
        <span class="font-display text-xl font-extrabold tracking-tight">OBSCURA</span>
        <span class="text-[10px] font-semibold uppercase tracking-[0.35em] text-forest-500"
          >Lawn Care</span
        >
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 lg:flex" data-nav-links>
      {
        nav.map((item) =>
          item.children ? (
            <li class="relative" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                  isActive(item.href) ? 'text-forest-400' : 'hover:text-forest-400',
                ]}
              >
                {item.label}
                <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
              </a>
              <div
                x-show="open"
                x-transition.opacity.duration.200ms
                x-cloak
                class="absolute left-0 top-full w-60 pt-3"
              >
                <ul class="overflow-hidden rounded-2xl border border-bone-200 bg-white p-2 shadow-premium">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="flex items-center justify-between rounded-xl px-4 py-2.5 text-sm font-medium text-forest-900 transition-colors hover:bg-forest-50 hover:text-forest-600"
                      >
                        {child.label}
                        <Icon name="arrow" class="h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
                  isActive(item.href) ? 'text-forest-400' : 'hover:text-forest-400',
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        )
      }
    </ul>

    <!-- Right side -->
    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={business.phoneHref}
        class="flex items-center gap-2 text-sm font-semibold transition-colors hover:text-forest-500"
      >
        <span
          class="flex h-9 w-9 items-center justify-center rounded-full transition-colors"
          :class="scrolled ? 'bg-forest-50 text-forest-600' : 'bg-white/10 text-forest-400'"
        >
          <Icon name="phone" class="h-4 w-4" />
        </span>
        {business.phone}
      </a>
      <a href="/contact" class="btn-primary !px-6 !py-3">Get a Free Quote</a>
    </div>

    <!-- Mobile toggle -->
    <button
      class="flex h-11 w-11 items-center justify-center rounded-xl bg-forest-50 text-forest-800 lg:hidden"
      @click="$dispatch('toggle-menu')"
      aria-label="Open menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </nav>
</header>

<!-- Mobile drawer -->
<div
  x-data="{ open: false }"
  @toggle-menu.window="open = !open"
  @keydown.escape.window="open = false"
  x-cloak
>
  <div
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 z-50 bg-forest-950/60 backdrop-blur-sm lg:hidden"
    @click="open = false"
  >
  </div>
  <aside
    x-show="open"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    class="fixed inset-y-0 right-0 z-50 flex w-[85%] max-w-sm flex-col bg-white shadow-premium lg:hidden"
  >
    <div class="flex items-center justify-between border-b border-bone-200 px-6 py-5">
      <span class="font-display text-lg font-extrabold">Menu</span>
      <button
        class="flex h-10 w-10 items-center justify-center rounded-xl bg-forest-50 text-forest-800"
        @click="open = false"
        aria-label="Close menu"
      >
        <Icon name="close" class="h-5 w-5" />
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-4 py-6">
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl px-4 py-3 text-base font-semibold text-forest-900 transition-colors hover:bg-forest-50"
              >
                {item.label}
              </a>
              {item.children && (
                <ul class="ml-3 mt-1 space-y-1 border-l-2 border-forest-100 pl-3">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-lg px-4 py-2 text-sm font-medium text-forest-700 transition-colors hover:bg-forest-50 hover:text-forest-600"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="space-y-3 border-t border-bone-200 px-6 py-6">
      <a href={business.phoneHref} class="flex items-center justify-center gap-2 text-sm font-semibold text-forest-900">
        <Icon name="phone" class="h-4 w-4 text-forest-600" />
        {business.phone}
      </a>
      <a href="/contact" class="btn-primary w-full">Get a Free Quote</a>
    </div>
  </aside>
</div>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
