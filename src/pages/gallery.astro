---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/site';

type Cat = 'mowing' | 'hardscaping' | 'cleanups' | 'landscaping';

const gallery: { src: string; cat: Cat; alt: string }[] = [
  { cat: 'mowing', alt: 'Freshly striped green lawn', src: 'https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'landscaping', alt: 'Lush layered garden beds', src: 'https://images.unsplash.com/photo-1622383563227-04401ab4e5ea?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'hardscaping', alt: 'Modern paver patio', src: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'cleanups', alt: 'Autumn leaf cleanup', src: 'https://images.unsplash.com/photo-1444492417251-9c84a5fa18e0?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'landscaping', alt: 'Estate lawn renovation', src: 'https://images.unsplash.com/photo-1605117882932-f9e32b03fea9?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'mowing', alt: 'Manicured commercial grounds', src: 'https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'landscaping', alt: 'Technician edging a lawn', src: 'https://images.unsplash.com/photo-1605117882932-f9e32b03fea9?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'hardscaping', alt: 'Garden stone walkway', src: 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'cleanups', alt: 'Raked autumn yard', src: 'https://images.unsplash.com/photo-1507371341162-763b5e419408?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'mowing', alt: 'Backyard with pristine turf', src: 'https://images.unsplash.com/photo-1560749003-f4b1e17e2dff?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'landscaping', alt: 'Flowering ornamental border', src: 'https://images.unsplash.com/photo-1466692476868-aef1dfb1e735?auto=format&fit=crop&w=1000&q=80' },
  { cat: 'hardscaping', alt: 'Retaining wall and plantings', src: 'https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?auto=format&fit=crop&w=1000&q=80' },
];

const tabs = [
  { key: 'all', label: 'All Work' },
  { key: 'mowing', label: 'Mowing' },
  { key: 'landscaping', label: 'Landscaping' },
  { key: 'hardscaping', label: 'Hardscaping' },
  { key: 'cleanups', label: 'Cleanups' },
];

const schema = [
  {
    '@type': 'ImageGallery',
    name: `${business.name} Project Gallery`,
    url: `${business.url}/gallery`,
  },
];
---

<Layout
  title="Lawn Care & Landscaping Photo Gallery"
  description="Browse Obscura Lawn Care's project gallery — mowing, landscaping, hardscaping & seasonal cleanups across the Triangle. Filter by category and view in full screen."
  schema={schema}
  footerCta={false}
>
  <PageHero
    eyebrow="Gallery"
    title="A portfolio of <span class='text-forest-400'>beautiful</span> outdoor spaces"
    subtitle="Explore our favorite transformations. Filter by category, then tap any image to view it full screen."
    image="https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=2000&q=80"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Gallery' }]}
  />

  <section
    class="section-py bg-bone-50"
    x-data={`{
      filter: 'all',
      lightbox: false,
      current: 0,
      images: ${JSON.stringify(gallery)},
      get visible() { return this.filter === 'all' ? this.images : this.images.filter(i => i.cat === this.filter) },
      open(src) { this.current = this.visible.findIndex(i => i.src === src); this.lightbox = true; document.body.style.overflow = 'hidden' },
      close() { this.lightbox = false; document.body.style.overflow = '' },
      next() { this.current = (this.current + 1) % this.visible.length },
      prev() { this.current = (this.current - 1 + this.visible.length) % this.visible.length }
    }`}
    @keydown.escape.window="close()"
    @keydown.arrow-right.window="lightbox && next()"
    @keydown.arrow-left.window="lightbox && prev()"
  >
    <div class="container-px">
      <SectionHeading eyebrow="Portfolio" title="Browse the gallery" />

      <!-- Filter tabs -->
      <div class="reveal mt-10 flex flex-wrap justify-center gap-3">
        {
          tabs.map((t) => (
            <button
              @click={`filter = '${t.key}'`}
              :class={`filter === '${t.key}' ? 'bg-forest-600 text-white shadow-glow' : 'bg-white text-forest-800 hover:bg-forest-50'`}
              class="rounded-full border border-bone-200 px-6 py-2.5 text-sm font-semibold transition-all"
            >
              {t.label}
            </button>
          ))
        }
      </div>

      <!-- Masonry-ish grid -->
      <div class="reveal mt-12 columns-1 gap-5 sm:columns-2 lg:columns-3 [&>*]:mb-5">
        {
          gallery.map((img) => (
            <button
              x-show={`filter === 'all' || filter === '${img.cat}'`}
              x-transition.opacity
              @click={`open('${img.src}')`}
              class="group relative block w-full overflow-hidden rounded-2xl shadow-card focus:outline-none focus-visible:ring-2 focus-visible:ring-forest-500"
            >
              <img src={img.src} alt={img.alt} loading="lazy" class="w-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <span class="absolute inset-0 flex items-center justify-center bg-forest-950/0 transition-colors duration-300 group-hover:bg-forest-950/40">
                <span class="flex h-12 w-12 scale-75 items-center justify-center rounded-full bg-white/90 text-forest-800 opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100">
                  <Icon name="search" class="h-5 w-5" />
                </span>
              </span>
              <span class="absolute left-3 top-3 rounded-full bg-forest-950/70 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white capitalize">
                {img.cat}
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <!-- Lightbox -->
    <div
      x-show="lightbox"
      x-cloak
      x-transition.opacity
      class="fixed inset-0 z-[60] flex items-center justify-center bg-forest-950/95 p-4 backdrop-blur"
      @click.self="close()"
    >
      <button @click="close()" class="absolute right-5 top-5 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20" aria-label="Close">
        <Icon name="close" class="h-6 w-6" />
      </button>
      <button @click="prev()" class="absolute left-3 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:left-6" aria-label="Previous">
        <Icon name="arrow" class="h-6 w-6 rotate-180" />
      </button>
      <button @click="next()" class="absolute right-3 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:right-6" aria-label="Next">
        <Icon name="arrow" class="h-6 w-6" />
      </button>
      <figure class="max-h-[85vh] max-w-5xl">
        <img :src="visible[current]?.src" :alt="visible[current]?.alt" class="max-h-[80vh] w-auto rounded-2xl object-contain shadow-premium" />
        <figcaption class="mt-4 text-center text-sm text-forest-100/80">
          <span x-text="visible[current]?.alt"></span>
          <span class="mx-2 text-forest-100/40">•</span>
          <span x-text="`${current + 1} / ${visible.length}`"></span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-forest-800">
    <div class="container-px flex flex-col items-center justify-between gap-6 py-14 text-center sm:flex-row sm:text-left">
      <div>
        <h2 class="font-display text-2xl font-extrabold text-white sm:text-3xl">Like what you see?</h2>
        <p class="mt-2 text-forest-100/80">Let's add your property to the gallery.</p>
      </div>
      <a href="/contact" class="btn-primary !bg-white !text-forest-800 hover:!bg-bone-100">
        Get a Free Quote
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </section>
</Layout>
