---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { business } from '../data/site';

const sections = [
  {
    h: 'Acceptance of terms',
    p: `By accessing our website or using our services, you agree to these Terms of Service. If you do not agree, please discontinue use of our website and services.`,
  },
  {
    h: 'Services & estimates',
    p: `Quotes and estimates are based on the information provided and a visual assessment of your property. Final pricing may be adjusted if on-site conditions differ materially from what was described. We will always communicate any changes before performing additional work.`,
  },
  {
    h: 'Scheduling & cancellations',
    p: `We make every effort to service your property on the scheduled day. Weather and conditions beyond our control may require rescheduling, in which case we will notify you. Recurring service may be paused or cancelled with reasonable notice.`,
  },
  {
    h: 'Payment',
    p: `Payment is due according to the terms outlined in your estimate or service agreement. Late payments may be subject to fees. We accept standard forms of payment as communicated at the time of service.`,
  },
  {
    h: 'Satisfaction guarantee',
    p: `If you are not satisfied with a completed visit, contact us within 48 hours and we will return to address the issue at no additional charge, subject to the terms of your service agreement.`,
  },
  {
    h: 'Limitation of liability',
    p: `To the fullest extent permitted by law, ${business.legalName} is not liable for indirect, incidental, or consequential damages arising from the use of our website or services.`,
  },
  {
    h: 'Contact us',
    p: `Questions about these terms? Reach us at ${business.email} or ${business.phone}.`,
  },
];
---

<Layout
  title="Terms of Service"
  description="Review the Obscura Lawn Care terms of service governing the use of our website and lawn care services."
  noindex
>
  <PageHero
    eyebrow="Legal"
    title="Terms of Service"
    subtitle="The terms that govern our website and the services we provide."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Terms of Service' }]}
  />
  <section class="section-py bg-white">
    <div class="container-px mx-auto max-w-3xl">
      <p class="text-sm text-forest-900/50">Last updated: January 2026</p>
      <div class="mt-8 space-y-10">
        {
          sections.map((s) => (
            <div>
              <h2 class="font-display text-2xl font-bold text-forest-900">{s.h}</h2>
              <p class="mt-3 leading-relaxed text-forest-900/70">{s.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
