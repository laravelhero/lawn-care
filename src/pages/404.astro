---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/site';
---

<Layout
  title="Page Not Found"
  description="The page you're looking for has wandered off the lawn. Head back home or explore our lawn care services."
  noindex
>
  <section class="relative isolate flex min-h-[80vh] items-center overflow-hidden bg-forest-950 pt-20 text-white">
    <div class="absolute inset-0 -z-10">
      <img
        src="https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="h-full w-full object-cover opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-forest-950/70 to-forest-950"></div>
    </div>
    <div class="container-px text-center">
      <p class="font-display text-[7rem] font-extrabold leading-none text-forest-400 sm:text-[10rem]">404</p>
      <h1 class="mt-2 font-display text-3xl font-extrabold sm:text-4xl">This patch is overgrown</h1>
      <p class="mx-auto mt-4 max-w-md text-forest-100/80">
        The page you're looking for has wandered off the lawn. Let's get you back on solid ground.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">
          Back Home
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/contact" class="btn-secondary">Get a Free Quote</a>
      </div>
      <div class="mx-auto mt-12 flex max-w-xl flex-wrap justify-center gap-3">
        {
          services.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="rounded-full border border-forest-800 bg-forest-900/50 px-4 py-2 text-sm font-medium text-forest-100/80 transition hover:bg-forest-800"
            >
              {s.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
